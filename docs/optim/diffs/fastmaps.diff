+        .collect();
+    assert_eq!(offs.len(), SIZE + 1);
+    assert_eq!(offs, (0..=SIZE as u64).collect::<Vec<_>>());
+}
+
+/// `capped:N` keeps at most N reads per (pixel, file) and shrinks the stream.
+#[test]
+fn capped_limits_reads_per_pixel_and_labels_json() {
+    let fx = tmpdir("caprows");
+    let fq = fixture(&fx);
+
+    let exact = run("capex", &fq, &["--data-mode", "exact"]);
+    let capped = run("capcap", &fq, &["--data-mode", "capped:2"]);
+
+    let je = json(&exact);
+    assert!(
+        je.get("data_complete").is_none(),
+        "exact mode must not carry a data-completeness label: {je}"
+    );
+    assert!(
+        je.get("data_reads_per_pixel").is_none(),
+        "exact mode must not carry a cap label: {je}"
+    );
+
+    let jc = json(&capped);
+    assert_eq!(jc["data_complete"], Value::Bool(false));
+    assert_eq!(jc["data_reads_per_pixel"], 2);
+
+    let de = data(&exact);
+    let dc = data(&capped);
+    assert!(
+        dc.len() < de.len(),
+        "capped:2 must shrink heatmap.data ({} vs {})",
+        dc.len(),
+        de.len()
+    );
+    assert_ne!(dc, de, "capped:2 must not reproduce the exact stream");
+
+    // 14 reads, 4 pixels, cap 2 → 4 pixels × 2 reads kept = 8 of 14.
+    // Decode `n_stored` per pixel and check the cap held everywhere.
+    let mut pos = 0usize;
+    let mut total = 0usize;
+    let n_rows = SIZE;
+    for _ in 0..n_rows {
+        let n_pixels = varint(&dc, &mut pos);
+        for _ in 0..n_pixels {
+            let _x = varint(&dc, &mut pos);
+            let n_groups = varint(&dc, &mut pos);
+            // groups: varint(file_id) varint(n_reads) varint*n_reads
+            let mut stored = 0u64;
+            for _ in 0..n_groups {
+                let _fid = varint(&dc, &mut pos);
+                let n_reads = varint(&dc, &mut pos);
+                assert!(n_reads <= 2, "capped:2 stored {n_reads} reads in one group");
+                for _ in 0..n_reads {
+                    let _ = varint(&dc, &mut pos);
+                }
+                stored += n_reads;
+            }
+            assert!(stored <= 2, "capped:2 stored {stored} reads at one pixel");
+            total += stored as usize;
+        }
+    }
+    assert_eq!(pos, dc.len(), "capped:2 stream must decode exactly");
+    assert_eq!(total, 8, "4 pixels × cap 2 = 8 reads kept");
+}
+
+fn varint(buf: &[u8], pos: &mut usize) -> u64 {
+    let mut shift = 0u32;
+    let mut out = 0u64;
+    loop {
+        let b = buf[*pos];
+        *pos += 1;
+        out |= ((b & 0x7f) as u64) << shift;
+        if b & 0x80 == 0 {
+            return out;
+        }
+        shift += 7;
+    }
+}
+
+/// The v1 wrapper carries the same two flags as metrics, so a downstream
+/// consumer cannot mistake an approximation for the exact stream.
+#[test]
+fn non_exact_modes_label_the_v1_wrapper() {
+    let fx = tmpdir("wrapper");
+    let fq = fixture(&fx);
+
+    for (tag, mode, cap) in [("w_off", "off", 0.0), ("w_cap", "capped:2", 2.0)] {
+        let dir = std::env::temp_dir().join(format!("maps_dm_{tag}_{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&dir);
+        std::fs::create_dir_all(&dir).unwrap();
+        let jsonp = dir.join("grid.json");
+        let r = run(
+            tag,
+            &fq,
+            &[
+                "--data-mode",
+                mode,
+                "--json",
+                jsonp.to_str().unwrap(),
+            ],
+        );
+        let rp = r.report.expect("report path recorded");
+        let text = std::fs::read_to_string(&rp).unwrap();
+        let v: Value = serde_json::from_str(&text).unwrap();
+        assert_eq!(v["schema"], "fastsuite.report.v1");
+        assert_eq!(v["metrics"]["data_complete"].as_f64().unwrap(), 0.0);
+        assert_eq!(v["metrics"]["data_reads_per_pixel"].as_f64().unwrap(), cap);
+    }
+
+    // Exact mode: no metrics, no keys — the wrapper shape is untouched.
+    let dir = std::env::temp_dir().join(format!("maps_dm_w_ex_{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&dir);
+    std::fs::create_dir_all(&dir).unwrap();
+    let jsonp = dir.join("grid.json");
+    let r = run(
+        "w_exact",
+        &fq,
+        &["--data-mode", "exact", "--json", jsonp.to_str().unwrap()],
+    );
+    let text = std::fs::read_to_string(r.report.unwrap()).unwrap();
+    let v: Value = serde_json::from_str(&text).unwrap();
+    assert!(v["metrics"].get("data_complete").is_none(), "{text}");
+    assert!(v["metrics"].get("data_reads_per_pixel").is_none(), "{text}");
+}
+
+/// The run summary has to say which stream the user got.
+#[test]
+fn run_summary_names_a_non_exact_mode() {
+    let fx = tmpdir("summary");
+    let fq = fixture(&fx);
+
+    let off = run("sum_off", &fq, &["--data-mode", "off"]);
+    assert!(
+        off.stderr.contains("data-mode off") || off.stderr.contains("data mode = off"),
+        "off: run summary must name the mode; stderr:\n{}",
+        off.stderr
+    );
+    assert!(
+        off.stderr.contains("data_complete=false"),
+        "off: run summary must flag the approximation; stderr:\n{}",
+        off.stderr
+    );
+
+    let cap = run("sum_cap", &fq, &["--data-mode", "capped:3"]);
+    assert!(
+        cap.stderr.contains("capped:3"),
+        "capped: run summary must name the cap; stderr:\n{}",
+        cap.stderr
+    );
+
+    let ex = run("sum_ex", &fq, &[]);
+    assert!(
+        !ex.stderr.contains("data_complete")
+            && !ex.stdout.contains("data_complete")
+            && !ex.stdout.contains("data-mode"),
+        "exact (default): the summary must stay silent about data mode"
+    );
+}
diff --git a/tools/fastmaps/tests/crlf_test.rs b/tools/fastmaps/tests/crlf_test.rs
new file mode 100644
index 0000000..205a648
--- /dev/null
+++ b/tools/fastmaps/tests/crlf_test.rs
@@ -0,0 +1,91 @@
+//! FM-10 — the FASTQ loop reads bytes, not `String`s.
+//!
+//! `BufRead::lines()` allocates a `String` per line and validates UTF-8;
+//! `read_until` into reused `Vec<u8>` does neither. The two must agree byte for
+//! byte, including on CRLF input: `lines()` strips a trailing `\r`, so the
+//! byte loop has to strip it too or every `\r` read would gain a base of length
+//! and move the (x, y) plane.
+//!
+//! The same path is overwritten between runs so the file path embedded in
+//! `heatmap.json` is identical and *all five* outputs can be compared.
+
+use std::path::Path;
+use std::process::Command;
+
+fn bin() -> &'static str {
+    env!("CARGO_BIN_EXE_fastmaps")
+}
+
+fn body(eol: &str) -> String {
+    let reads = [
+        ("@r0", "A".repeat(150)),
+        ("@r1", "ACGT".repeat(37) + "AC"),
+        ("@r2", "T".repeat(140) + &"G".repeat(10)),
+        ("@r3", "N".repeat(150)),
+        ("@r4", "ACGTACGTAC".repeat(15)),
+    ];
+    let mut s = String::new();
+    for (h, seq) in reads {
+        s.push_str(&format!("{h}{eol}{seq}{eol}+{eol}{}{eol}", "I".repeat(seq.len())));
+    }
+    s
+}
+
+fn run(fq: &Path, out: &Path) {
+    let o = Command::new(bin())
+        .arg("-o")
+        .arg(out)
+        .arg("--force")
+        .arg(fq)
+        .output()
+        .unwrap();
+    assert!(
+        o.status.success(),
+        "run failed: {}",
+        String::from_utf8_lossy(&o.stderr)
+    );
+}
+
+#[test]
+fn crlf_input_matches_lf_input_byte_for_byte() {
+    let dir = std::env::temp_dir().join(format!("maps_crlf_{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&dir);
+    std::fs::create_dir_all(&dir).unwrap();
+
+    let fq = dir.join("x_R1.fastq");
+    let out_lf = dir.join("out_lf");
+    let out_crlf = dir.join("out_crlf");
+
+    std::fs::write(&fq, body("\n")).unwrap();
+    run(&fq, &out_lf);
+
+    std::fs::write(&fq, body("\r\n")).unwrap();
+    run(&fq, &out_crlf);
+
+    for f in [
+        "heatmap.json",
+        "heatmap.png",
+        "heatmap.data",
+        "heatmap.preview",
+        "heatmap_3d.html",
+    ] {
+        let a = std::fs::read(out_lf.join(f)).unwrap();
+        let b = std::fs::read(out_crlf.join(f)).unwrap();
+        assert_eq!(
+            a.len(),
+            b.len(),
+            "{f}: CRLF input must not change the output size ({} vs {})",
+            a.len(),
+            b.len()
+        );
+        assert!(a == b, "{f}: CRLF input must be byte-identical to LF input");
+    }
+
+    // And the read length really is 150 for every read in both runs.
+    let text = std::fs::read_to_string(out_crlf.join("heatmap.json")).unwrap();
+    let v: serde_json::Value = serde_json::from_str(&text).unwrap();
+    assert_eq!(v["size"], 151, "a stray \\r would make size 152");
+    assert_eq!(v["total_reads"], 5);
+
+    let _ = std::fs::remove_dir_all(&dir);
+}
diff --git a/tools/fastmaps/tests/buffer_independence_test.rs b/tools/fastmaps/tests/buffer_independence_test.rs
new file mode 100644
index 0000000..05499fa
--- /dev/null
+++ b/tools/fastmaps/tests/buffer_independence_test.rs
@@ -0,0 +1,111 @@
+//! FM-2 / FM-3 / FM-9 — the spill path must be invisible in the outputs.
+//!
+//! `--buffer-mb` is a memory knob, not an output knob. This test drives the
+//! same input through three budgets that take three different code paths:
+//! `--buffer-mb 1` (one worker, 1 MiB share, so the index buffer spills several
+//! times and rows get reopened by the spiller), `--buffer-mb 2` (two spills)
+//! and `--buffer-mb 64` (nothing ever spills).
+//!
+//! All four gated outputs must hash the same. It also exercises the preview
+//! flush while spilling (previews are flushed on their own, much smaller,
+//! threshold), so a budget-derived preview threshold that split previews
+//! differently would show up here.
+
+use std::path::{Path, PathBuf};
+use std::process::Command;
+
+fn bin() -> &'static str {
+    env!("CARGO_BIN_EXE_fastmaps")
+}
+
+/// Deterministic 150 bp reads with a spread of compositions (so the grid has
+/// many pixels and the preview buffer actually fills) and varied qualities.
+fn fixture(dir: &Path, n_reads: usize) -> String {
+    let fq = dir.join("buf_R1.fastq");
+    let mut s = String::with_capacity(n_reads * 320);
+    let mut state: u64 = 0x2545_F491_4F6C_DD1D;
+    let mut next = || {
+        state ^= state << 13;
+        state ^= state >> 7;
+        state ^= state << 17;
+        state
+    };
+    for i in 0..n_reads {
+        let mut seq = String::with_capacity(150);
+        for _ in 0..150 {
+            seq.push(match next() % 4 {
+                0 => 'A',
+                1 => 'C',
+                2 => 'G',
+                _ => 'T',
+            });
+        }
+        let mut qual = String::with_capacity(150);
+        for _ in 0..150 {
+            // '!'..'J' → Q0..Q41, so mean quality varies per read.
+            qual.push((33 + (next() % 42) as u8) as char);
+        }
+        s.push_str(&format!("@b{i}\n{seq}\n+\n{qual}\n"));
+    }
+    std::fs::write(&fq, s).unwrap();
+    fq.to_string_lossy().to_string()
+}
+
+fn run(tag: &str, fq: &str, extra: &[&str]) -> PathBuf {
+    let dir = std::env::temp_dir().join(format!("maps_buf_{tag}_{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&dir);
+    std::fs::create_dir_all(&dir).unwrap();
+    let o = Command::new(bin())
+        .arg("-o")
+        .arg(&dir)
+        .arg("--force")
+        .arg(fq)
+        .args(extra)
+        .output()
+        .unwrap();
+    assert!(
+        o.status.success(),
+        "run {tag} failed: {}",
+        String::from_utf8_lossy(&o.stderr)
+    );
+    dir
+}
+
+#[test]
+fn output_is_identical_across_buffer_budgets() {
+    let fx = std::env::temp_dir().join(format!("maps_buf_fx_{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&fx);
+    std::fs::create_dir_all(&fx).unwrap();
+    // 70 000 reads × 8 B spilled = 560 KB per record stream; with one worker
+    // the 1 MiB share holds 65 536 of them, so this spills at least once.
+    let fq = fixture(&fx, 70_000);
+
+    let a = run("mb1", &fq, &["--buffer-mb", "1", "-j", "1"]);
+    let b = run("mb2", &fq, &["--buffer-mb", "2", "-j", "1"]);
+    let c = run("mb64", &fq, &["--buffer-mb", "64", "-j", "1"]);
+
+    for f in ["heatmap.json", "heatmap.png", "heatmap.data", "heatmap.preview"] {
+        let ra = std::fs::read(a.join(f)).unwrap();
+        for (tag, dir) in [("--buffer-mb 2", &b), ("--buffer-mb 64", &c)] {
+            let rb = std::fs::read(dir.join(f)).unwrap();
+            assert!(
+                ra == rb,
+                "{f} differs between --buffer-mb 1 and {tag} ({} vs {} bytes)",
+                ra.len(),
+                rb.len()
+            );
+        }
+    }
+
+    // Sanity: the grid is not degenerate, so the comparison is meaningful.
+    let j: serde_json::Value =
+        serde_json::from_str(&std::fs::read_to_string(a.join("heatmap.json")).unwrap()).unwrap();
+    assert_eq!(j["total_reads"], 70_000);
+    let occupied = j["counts"].as_array().unwrap().iter().filter(|c| c.as_u64().unwrap() > 0).count();
+    assert!(occupied > 500, "fixture should populate many pixels, got {occupied}");
+
+    let _ = std::fs::remove_dir_all(&fx);
+    let _ = std::fs::remove_dir_all(&a);
+    let _ = std::fs::remove_dir_all(&b);
+    let _ = std::fs::remove_dir_all(&c);
+}
diff --git a/tools/fastmaps/tests/heatmap_3d_determinism_test.rs b/tools/fastmaps/tests/heatmap_3d_determinism_test.rs
new file mode 100644
index 0000000..4541c9b
--- /dev/null
+++ b/tools/fastmaps/tests/heatmap_3d_determinism_test.rs
@@ -0,0 +1,122 @@
+//! FM-12 — `heatmap_3d.html` must be reproducible.
+//!
+//! Two independent sources of non-determinism fed this file:
+//!
+//!   1. the per-pixel mean quality was an `f64` partial per worker, merged in
+//!      *thread-completion* order (`Done` messages race), and
+//!   2. the series was emitted in `HashMap` iteration order, which is seeded
+//!      per process.
+//!
+//! So the file differed between two runs of the identical command. It is now
+//! built from integer `(sum_q, sum_len)` accumulators and sorted by `(x, y)`.
+//! Every other output was already deterministic (integer counts + a sorted
+//! encoder); this test pins the last one.
+
+use std::path::{Path, PathBuf};
+use std::process::Command;
+
+fn bin() -> &'static str {
+    env!("CARGO_BIN_EXE_fastmaps")
+}
+
+fn write_fq(path: &Path, seed: u64, n: usize) {
+    let mut state = seed | 1;
+    let mut next = || {
+        state ^= state << 13;
+        state ^= state >> 7;
+        state ^= state << 17;
+        state
+    };
+    let mut s = String::with_capacity(n * 330);
+    for i in 0..n {
+        let mut seq = String::with_capacity(150);
+        for _ in 0..150 {
+            seq.push(match next() % 4 {
+                0 => 'A',
+                1 => 'C',
+                2 => 'G',
+                _ => 'T',
+            });
+        }
+        let mut qual = String::with_capacity(150);
+        for _ in 0..150 {
+            qual.push((33 + (next() % 42) as u8) as char);
+        }
+        s.push_str(&format!("@d{i}\n{seq}\n+\n{qual}\n"));
+    }
+    std::fs::write(path, s).unwrap();
+}
+
+fn run(files: &[String], j: &str, tag: &str) -> PathBuf {
+    let dir = std::env::temp_dir().join(format!("maps_3d_{tag}_{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&dir);
+    std::fs::create_dir_all(&dir).unwrap();
+    let mut c = Command::new(bin());
+    c.arg("-o").arg(&dir).arg("--force").args(files).args(["-j", j]);
+    let o = c.output().unwrap();
+    assert!(
+        o.status.success(),
+        "-j {j} run failed: {}",
+        String::from_utf8_lossy(&o.stderr)
+    );
+    dir
+}
+
+#[test]
+fn heatmap_3d_html_is_stable_across_runs_and_threads() {
+    let fx = std::env::temp_dir().join(format!("maps_3d_fx_{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&fx);
+    std::fs::create_dir_all(&fx).unwrap();
+
+    // One mate pair: two files, so -j 2 gives two workers with four files worth
+    // of nothing — the file→worker partition is forced (no race over which
+    // worker owns which file), which is what makes the *other* outputs
+    // comparable run to run. The html comparison still spans the thread split.
+    let mut files = Vec::new();
+    for (i, seed) in [11u64, 23].iter().enumerate() {
+        let p = fx.join(format!("s{i}_R{}.fastq", 1 + i));
+        write_fq(&p, *seed, 6_000);
+        files.push(p.to_string_lossy().to_string());
+    }
+
+    // Two runs per -j: the first pair isolates the per-process `HashMap` seed,
+    // the rest isolate thread scheduling.
+    let mut dirs = Vec::new();
+    for j in ["1", "2"] {
+        for rep in ["a", "b"] {
+            dirs.push((j, run(&files, j, &format!("j{j}{rep}"))));
+        }
+    }
+
+    // `heatmap_3d.html` must be identical across *every* run, including across
+    // -j: its series is sorted and its quality values are exact integers now.
+    let first = std::fs::read(dirs[0].1.join("heatmap_3d.html")).unwrap();
+    assert!(!first.is_empty());
+    for (j, d) in dirs.iter().skip(1) {
+        let other = std::fs::read(d.join("heatmap_3d.html")).unwrap();
+        assert!(
+            first == other,
+            "heatmap_3d.html differs between -j {} run a and -j {j} ({} vs {} bytes)",
+            dirs[0].0,
+            first.len(),
+            other.len()
+        );
+    }
+
+    // The other outputs must be identical between two runs *at the same -j*
+    // (`heatmap.preview` is not -j invariant: the per-(pixel, kind) quota is
+    // per worker by design, and that predates this change).
+    for pair in dirs.chunks(2) {
+        let ((j, a), (_, b)) = (&pair[0], &pair[1]);
+        for f in ["heatmap.json", "heatmap.data", "heatmap.preview", "heatmap.png"] {
+            let ra = std::fs::read(a.join(f)).unwrap();
+            let rb = std::fs::read(b.join(f)).unwrap();
+            assert!(ra == rb, "{f} differs between two -j {j} runs");
+        }
+    }
+
+    let _ = std::fs::remove_dir_all(&fx);
+    for (_, d) in &dirs {
+        let _ = std::fs::remove_dir_all(d);
+    }
+}
