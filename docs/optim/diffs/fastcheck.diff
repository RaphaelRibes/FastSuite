+            cases.push((pat.as_bytes().to_vec(), pat.as_bytes().to_vec()));
+            cases.push((pat.to_ascii_lowercase().into_bytes(), pat.as_bytes().to_vec()));
+            cases.push((b"ACGTACGTACGTACGT".to_vec(), pat.as_bytes().to_vec()));
