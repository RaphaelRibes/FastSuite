+        const HAY_ALPHABET: &[u8] = b"ACGTacgt@`[{N. nAGATCG";
+        const NEEDLE_ALPHABET: &[u8] = b"ACGTacgt@`[";
+        let mut rng = Rng(0xC0FF_EE11);
